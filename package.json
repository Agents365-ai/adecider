{
  "name": "adecider",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable System One typed decisions for any coding agent: Jev, Laya, or any OpenAI-compatible model, over MCP",
  "type": "module",
  "license": "MIT",
  "bin": {
    "adecider": "./bin/adecider.js",
    "adecider-gate": "./bin/adecider-gate.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "status": "node src/cli/main.ts status",
    "mcp": "node src/mcp/server.ts",
    "smoke": "pi -ne -e ./src/harness/pi/index.ts -p --no-session 'List the names of every tool available to you, one per line, and nothing else.'",
    "models": "node src/cli/main.ts models",
    "serve": "node src/cli/main.ts serve"
  },
  "pi": {
    "extensions": [
      "./src/harness/pi/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "adecider",
    "jev",
    "laya",
    "mcp",
    "typed-decisions",
    "calibration"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
